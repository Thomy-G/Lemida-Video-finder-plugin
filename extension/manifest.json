{
  "manifest_version": 3,
  "name": "Lemida Video Finder (BIU Moodle)",
  "version": "1.0.1",
  "description": "Extract, preview, and download direct video links from Bar-Ilan University Lemida (Moodle) courses.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lemida Video Finder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "https://lemida.biu.ac.il/*",
    "https://*.biu.ac.il/*",
    "https://*.kaltura.com/*",
    "https://*.panopto.com/*",
    "https://*.panopto.eu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lemida.biu.ac.il/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
